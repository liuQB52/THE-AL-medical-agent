# API密钥配置
OPENAI_API_KEY=your_openai_key
LLAMA_API_KEY=your_llama_key

# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/medical_agent

# 模型配置
CPDM_MODEL_PATH=./models/cpdm/checkpoint.pt
MOOSE_MODEL_PATH=./models/moose/model.pt
AUTOPET_MODEL_PATH=./models/autopet/model.pt

# 服务配置
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
DEBUG=True
ENVIRONMENT=development

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
